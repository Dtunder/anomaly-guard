# AnomalyGuard Environment Variables

# Use mock data generation instead of connecting to a real message broker
MOCK_DATA=true

# Thresholds for alert severity based on Isolation Forest score
ALERT_THRESHOLD_HIGH=0.8
ALERT_THRESHOLD_MEDIUM=0.6

# Set to true to use a mock LLM for any LLM-related testing (if added later)
MOCK_LLM=false
USE_MOCK_MODEL=false
